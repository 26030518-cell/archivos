# 07. Operadores de asignación — ejemplo
cantidad = 10
print("Inicial:", cantidad)
cantidad += 5
print("Después de += 5:", cantidad)
cantidad -= 2
print("Después de -= 2:", cantidad)
cantidad *= 2
print("Después de *= 2:", cantidad)
cantidad /= 2
print("Después de /= 2:", cantidad)

# 07 EXTRA. Acumular puntos
