# 15. Conjuntos — ejemplo
frutas = {"manzana", "naranja", "manzana", "pera"}
print("Frutas sin repetir:", frutas)
frutas.add("uva")
print("Después de agregar uva:", frutas)
frutas.discard("pera")
print("Después de quitar pera:", frutas)

