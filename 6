# 06. Operadores aritméticos — ejemplo
print("Suma:", 5 + 3)
print("Resta:", 5 - 3)
print("Multiplicación:", 5 * 3)
print("División:", 5 / 3)
print("Residuo:", 10 % 3)
print("Potencia:", 2 ** 3)

