# 03. Strings — ejemplo
nombre = "Leonardo"
apellido = "Silva"
print("Nombre completo:", nombre + " " + apellido)
print("Mayúsculas:", nombre.upper())
print("Minúsculas:", nombre.lower())
print("Cantidad de letras:", len(nombre))
print("Primera letra:", nombre[0])

